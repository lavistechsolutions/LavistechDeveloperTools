<Window x:Class="LavistechDeveloperTools.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Lavistech DeveloperTools" Height="820" Width="1280" MinHeight="650" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#F5F7FA">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Sidebar}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
     <TextBlock Text="Lavistech DeveloperTools" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <TextBox x:Name="SearchBox" Height="34" AcceptsReturn="False" VerticalScrollBarVisibility="Disabled" TextChanged="SearchBox_TextChanged"
      Background="#263650" Foreground="White" BorderBrush="#354966" Padding="9" ToolTip="Search tools"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
     <Button Content="About" Click="About_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DCE5F1" Margin="0,0,0,4"/>
     <TextBlock Text="Version 1.0.0  •  Offline utilities" Foreground="#8395AF" FontSize="10" Margin="12,0,0,0"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="NavPanel" Margin="10,0,10,20">
      <TextBlock Text="WORKSPACE" Foreground="#8395AF" FontSize="10" FontWeight="Bold" Margin="12,8,0,8"/>
      <Button Content="⌂   Dashboard" Tag="Dashboard" Click="Nav_Click" Style="{StaticResource {x:Type Button}}" HorizontalContentAlignment="Left" Background="#2878E5" Foreground="White" Margin="0,2"/>
      <TextBlock Text="FORMATTING &amp; CONVERSION" Foreground="#8395AF" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
      <Button Content="{}   JSON Formatter" Tag="JSON Formatter" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <Button Content="⇄   XML to JSON" Tag="XML to JSON" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <Button Content="▣   Base64 Encoder" Tag="Base64 Encoder" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <TextBlock Text="SECURITY &amp; IDENTIFIERS" Foreground="#8395AF" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
      <Button Content="◈   JWT Decoder" Tag="JWT Decoder" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <Button Content="✧   GUID Generator" Tag="GUID Generator" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <Button Content="#   Hash Generator" Tag="Hash Generator" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <Button Content="⌕   File Checksum" Tag="File Checksum" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <TextBlock Text="DEVELOPMENT" Foreground="#8395AF" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
      <Button Content=".*   Regex Tester" Tag="Regex Tester" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
      <Button Content="◷   Cron Helper" Tag="Cron Helper" Click="Nav_Click" Background="Transparent" Foreground="#DCE5F1" HorizontalContentAlignment="Left"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="34,28,34,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Margin="0,0,0,24">
    <TextBlock x:Name="PageTitle" Text="Developer Tools Dashboard" FontSize="27" FontWeight="Bold" Foreground="#17243A"/>
    <TextBlock x:Name="PageSubtitle" Text="A collection of useful utilities for developers" Foreground="#718096" Margin="0,6,0,0"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <Grid>
     <UniformGrid x:Name="Dashboard" Columns="3" Margin="0,0,0,10">
      <Button Tag="JSON Formatter" Click="Nav_Click" Style="{StaticResource {x:Type Button}}" Background="White" Margin="0,0,12,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{}  JSON Formatter" FontWeight="Bold" FontSize="15"/><TextBlock Text="Format, validate and minify JSON" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="XML to JSON" Click="Nav_Click" Background="White" Margin="0,0,12,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇄  XML to JSON" FontWeight="Bold" FontSize="15"/><TextBlock Text="Convert XML documents to JSON" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="JWT Decoder" Click="Nav_Click" Background="White" Margin="0,0,0,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="◈  JWT Decoder" FontWeight="Bold" FontSize="15"/><TextBlock Text="Inspect JWT header and payload" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="GUID Generator" Click="Nav_Click" Background="White" Margin="0,0,12,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="✧  GUID Generator" FontWeight="Bold" FontSize="15"/><TextBlock Text="Generate one or many GUIDs" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="Regex Tester" Click="Nav_Click" Background="White" Margin="0,0,12,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text=".*  Regex Tester" FontWeight="Bold" FontSize="15"/><TextBlock Text="Test .NET regular expressions" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="Base64 Encoder" Click="Nav_Click" Background="White" Margin="0,0,0,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▣  Base64 Encoder" FontWeight="Bold" FontSize="15"/><TextBlock Text="Encode and decode Base64 text" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="Hash Generator" Click="Nav_Click" Background="White" Margin="0,0,12,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="#  Hash Generator" FontWeight="Bold" FontSize="15"/><TextBlock Text="Generate SHA-256 and SHA-512 hashes" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="Cron Helper" Click="Nav_Click" Background="White" Margin="0,0,12,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="◷  Cron Helper" FontWeight="Bold" FontSize="15"/><TextBlock Text="Understand common cron fields" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
      <Button Tag="File Checksum" Click="Nav_Click" Background="White" Margin="0,0,0,12" Padding="18" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⌕  File Checksum" FontWeight="Bold" FontSize="15"/><TextBlock Text="Verify files with SHA checksums" Foreground="#718096" Margin="0,9,0,8"/><TextBlock Text="Open tool →" Foreground="#2878E5"/></StackPanel></Button>
     </UniformGrid>
     <Border x:Name="ToolHost" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
      <StackPanel>
       <TextBlock x:Name="ToolDescription" Foreground="#718096" Margin="0,0,0,14"/>
       <StackPanel x:Name="ToolControls"/>
       <TextBlock Text="OUTPUT" Foreground="#718096" FontSize="10" FontWeight="Bold" Margin="0,18,0,7"/>
       <TextBox x:Name="OutputBox" MinHeight="180" MaxHeight="330" IsReadOnly="True" FontFamily="Consolas" Background="#F8FAFC"/>
       <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="Copy output" Click="Copy_Click" Background="#2878E5" Foreground="White" Margin="0,0,8,0"/>
        <Button Content="Clear" Click="Clear_Click" Background="#E8EEF5" Foreground="#26364D"/>
       </StackPanel>
       <TextBlock x:Name="StatusText" Foreground="#718096" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
