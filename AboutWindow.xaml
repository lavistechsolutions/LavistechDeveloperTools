<Window x:Class="LavistechDeveloperTools.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F7FA" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="28,24,28,16">
            <TextBlock Text="Lavistech DeveloperTools" FontSize="22" FontWeight="SemiBold" Foreground="#17243A"/>
            <TextBlock x:Name="VersionText" FontSize="14" Margin="0,4,0,0" Foreground="#718096"/>
            <TextBlock Text="Windows PC, 64-bit" FontSize="14" Margin="0,0,0,14" Foreground="#718096"/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8" Foreground="#17243A"
                       Text="A collection of offline developer utilities, put together by Lavistech Solutions."/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" Foreground="#718096"
                       Text="Formatting, decoding, and checksums run on this PC. Input is not uploaded."/>
            <TextBlock x:Name="FeedbackLink" Text="Feedback" Foreground="#2878E5" Cursor="Hand" TextDecorations="Underline"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#17243A">
            <UniformGrid Columns="3">
                <TextBlock x:Name="LicenseLink" Text="License" Style="{StaticResource AboutLink}"/>
                <TextBlock x:Name="EulaLink" Text="EULA" Style="{StaticResource AboutLink}"/>
                <TextBlock x:Name="NoticesLink" Text="Third-party notices" Style="{StaticResource AboutLink}"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
